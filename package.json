{
  "name": "rmt-flyer-maker",
  "version": "1.0.0",
  "description": "RMT Flyer Maker",
  "author": "Mahmoud Thabet",
  "main": "electron/main.js",
  "scripts": {
    "dist:win": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.0",
    "@capacitor/android": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.rmt.flyermaker",
    "productName": "RMT Flyer Maker",
    "files": [
      "www/**",
      "electron/**",
      "build/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "RMT Flyer Maker"
    }
  }
}
